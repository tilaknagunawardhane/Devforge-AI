{
  "title": "[[.Name]] - Service Overview",
  "uid": "[[.Name]]-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["devforge", "[[.Name]]"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods up",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"[[.Name]]\"})" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (req/s) by route",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(http_requests_total{job=\"[[.Name]]\"}[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error ratio (5xx)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=\"[[.Name]]\", status=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=\"[[.Name]]\"}[1m]))", "legendFormat": "5xx ratio" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"[[.Name]]\"}[1m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"[[.Name]]\"}[1m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"[[.Name]]\"}[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by status code",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total{job=\"[[.Name]]\"}[1m]))", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
