const http = require('http');
const client = require('prom-client');

const SERVICE_NAME = '[[.Name]]';
// Connection string for the [[.Database]] backend; wire your driver in here.
const DATABASE_URL = process.env.DATABASE_URL;

// Alerts and the Grafana dashboard generated by DevForge are written against these names.
const requests = new client.Counter({
  name: 'http_requests_total',
  help: 'Total HTTP requests by method, route and status code.',
  labelNames: ['method', 'route', 'status'],
});
const duration = new client.Histogram({
  name: 'http_request_duration_seconds',
  help: 'HTTP request latency by method and route.',
  labelNames: ['method', 'route'],
});

const KNOWN_ROUTES = new Set(['/', '/health', '/ready', '/metrics']);

function createServer() {
  return http.createServer(async (req, res) => {
    const start = process.hrtime.bigint();
    const path = req.url.split('?')[0];
    // Only known paths become label values, so metric cardinality stays bounded.
    const route = KNOWN_ROUTES.has(path) ? path : 'unmatched';

    res.on('finish', () => {
      const seconds = Number(process.hrtime.bigint() - start) / 1e9;
      duration.labels(req.method, route).observe(seconds);
      requests.labels(req.method, route, String(res.statusCode)).inc();
    });

    if (path === '/metrics') {
      res.writeHead(200, { 'Content-Type': client.register.contentType });
      res.end(await client.register.metrics());
    } else if (path === '/health' || path === '/ready') {
      // Liveness / readiness. Add dependency checks (database, etc.) to /ready.
      res.writeHead(200).end('ok');
    } else if (path === '/') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ service: SERVICE_NAME, status: 'ok' }));
    } else {
      res.writeHead(404).end('not found');
    }
  });
}

if (require.main === module) {
  const port = process.env.PORT || 8080;
  const server = createServer().listen(port, () => {
    console.log(JSON.stringify({ level: 'INFO', msg: 'service starting', service: SERVICE_NAME, port }));
  });
  // Graceful shutdown so rolling updates and chaos kills drain in-flight requests.
  process.on('SIGTERM', () => server.close(() => process.exit(0)));
  process.on('SIGINT', () => server.close(() => process.exit(0)));
}

module.exports = { createServer };
