# Staging: production-like (2 replicas, HPA up to 4, disruption budget kept).
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: [[.Name]]-staging
resources:
  - ../../base
  - namespace.yaml
[[- if .Operator]]
components:
  - ../../components/prometheus-operator
[[- end]]
labels:
  - pairs:
      environment: staging
    includeSelectors: false
patches:
  - target:
      kind: HorizontalPodAutoscaler
      name: [[.Name]]
    patch: |-
      - op: replace
        path: /spec/maxReplicas
        value: 4
