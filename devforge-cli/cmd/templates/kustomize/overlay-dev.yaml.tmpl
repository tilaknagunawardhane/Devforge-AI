# Dev: one replica, smaller footprint, no disruption budget.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: [[.Name]]-dev
resources:
  - ../../base
  - namespace.yaml
[[- if .Operator]]
components:
  - ../../components/prometheus-operator
[[- end]]
labels:
  - pairs:
      environment: dev
    includeSelectors: false
patches:
  - target:
      kind: HorizontalPodAutoscaler
      name: [[.Name]]
    patch: |-
      - op: replace
        path: /spec/minReplicas
        value: 1
      - op: replace
        path: /spec/maxReplicas
        value: 2
  - target:
      kind: Deployment
      name: [[.Name]]
    patch: |-
      - op: replace
        path: /spec/replicas
        value: 1
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/memory
        value: 96Mi
  - patch: |-
      $patch: delete
      apiVersion: policy/v1
      kind: PodDisruptionBudget
      metadata:
        name: [[.Name]]
