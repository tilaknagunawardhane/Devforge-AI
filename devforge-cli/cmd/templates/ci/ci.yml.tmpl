name: Build, Scan and Push

on:
  push:
    branches: ["main"]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout app code
        uses: actions/checkout@v4
[[- if eq .Language "go"]]

      - uses: actions/setup-go@v5
        with:
          go-version: "1.22"

      - name: Run tests
        run: |
          go mod tidy
          go vet ./...
          go test ./...
[[- else if eq .Language "python"]]

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run tests
        run: |
          pip install -r requirements-dev.txt
          pytest
[[- else if eq .Language "node"]]

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Run tests
        run: |
          npm install --no-audit --no-fund
          npm test
[[- end]]

  secret-scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout full history
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Run gitleaks from its public image: free for every account type
      - name: Scan for committed secrets (gitleaks)
        run: docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:v8.21.2 detect --source /repo --no-banner --redact

  build:
    needs: [test, secret-scan]
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    env:
      IMAGE: ${{ secrets.DOCKER_USERNAME }}/[[.Name]]:${{ github.sha }}
    steps:
      - name: Checkout app code
        uses: actions/checkout@v4

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_TOKEN }}

      - name: Build image (not pushed yet)
        uses: docker/build-push-action@v6
        with:
          context: .
          load: true
          tags: ${{ env.IMAGE }}

      - name: Scan image for vulnerabilities (Trivy)
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: ${{ env.IMAGE }}
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          exit-code: "1"

      - name: Push image
        run: docker push ${{ env.IMAGE }}

      - name: Checkout manifest repo
        uses: actions/checkout@v4
        with:
          # The separate GitOps manifest repository
          repository: ${{ github.repository_owner }}/devforge-manifests-[[.Name]]
          token: ${{ secrets.PAT_TOKEN }}
          path: manifest-repo

      - name: Update image tag and push
        run: |
          cd manifest-repo
          # Replace the image line in the Kustomize base with the newly built tag
          sed -i 's|image: .*|image: ${{ env.IMAGE }}|g' base/deployment.yaml
          git config user.name "DevForge GitOps Bot"
          git config user.email "bot@devforge.ai"
          git add base/deployment.yaml
          git commit -m "GitOps sync: update image to ${{ github.sha }}" || echo "nothing to commit"
          git push
