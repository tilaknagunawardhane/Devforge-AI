name: Build and Push

on:
  push:
    branches: ["main"]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout app code
        uses: actions/checkout@v4

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_TOKEN }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ secrets.DOCKER_USERNAME }}/[[.Name]]:${{ github.sha }}

      - name: Checkout manifest repo
        uses: actions/checkout@v4
        with:
          # The separate GitOps manifest repository
          repository: ${{ github.repository_owner }}/devforge-manifests-[[.Name]]
          token: ${{ secrets.PAT_TOKEN }}
          path: manifest-repo

      - name: Update image tag and push
        run: |
          cd manifest-repo
          # Replace the image line with the newly built tag
          sed -i 's|image: .*|image: ${{ secrets.DOCKER_USERNAME }}/[[.Name]]:${{ github.sha }}|g' deployment.yaml
          git config user.name "DevForge GitOps Bot"
          git config user.email "bot@devforge.ai"
          git add deployment.yaml
          git commit -m "GitOps sync: update image to ${{ github.sha }}" || echo "nothing to commit"
          git push
