# Generated files and anything run inside Linux containers must keep LF endings,
# even when checked out on Windows with core.autocrlf=true.
*.tmpl text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.go text eol=lf
Dockerfile text eol=lf
Dockerfile.tmpl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
