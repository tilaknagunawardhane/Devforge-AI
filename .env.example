# Copy to .env and fill in. Leave SLACK_WEBHOOK_URL empty to just log RCAs to the console.
SLACK_WEBHOOK_URL=
OLLAMA_MODEL=llama3
CHAOS_INTERVAL_SECONDS=60
GRAFANA_PASSWORD=admin

# Optional: Slack buttons (needs a Slack app with Interactivity -> https://<public-host>/slack/actions)
SLACK_SIGNING_SECRET=
PUBLIC_URL=http://localhost:9090
# Embedding model for runbook search (must be a real embedding model, not a chat model)
EMBED_MODEL=nomic-embed-text
